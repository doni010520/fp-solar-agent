# ── App ──────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
BUFFER_DEBOUNCE_SECONDS=8
TIMEZONE=America/Bahia

# Allowlist de telefones (separados por vírgula, só dígitos com DDI).
# VAZIO = responde todo mundo (produção). Útil pra fase de teste.
# Ex: ALLOWED_PHONES=5573999000111,5511988887777
ALLOWED_PHONES=

# ── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4o
OPENAI_TRANSCRIBE_MODEL=whisper-1

# ── Uazapi (WhatsApp) ────────────────────────────────────────
UAZAPI_BASE_URL=https://your-uazapi-host.example.com
UAZAPI_TOKEN=your-instance-token
UAZAPI_WEBHOOK_SECRET=defina-um-segredo-forte-aqui

# Grupo interno do time (destino das notificações)
# Formato: <id-numerico>@g.us — pegue via GET /chat/list no uazapi
INTERNAL_GROUP_ID=000000000000000000@g.us

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJI...
SUPABASE_ANON_KEY=eyJhbGciOiJI...

# Postgres direto (pooler em modo transaction — porta 6543)
DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:SENHA@aws-X-region.pooler.supabase.com:6543/postgres
